generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  passwordHash      String?
  role              String    @default("customer") // "customer" | "admin" | "cs" | "guide" | "finance"
  phone             String?
  country           String?
  preferredLanguage String    @default("en")
  preferredCurrency String    @default("USD")
  
  trips             Trip[]
  bookings          Booking[] @relation("CustomerBookings")
  assignedBookings  Booking[] @relation("AssignedTrips")
  assignedLeads     Lead[]
  submittedExpenses Expense[] @relation("SubmittedExpenses")
  approvedExpenses  Expense[] @relation("ApprovedExpenses")
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("users")
}

model Lead {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String?
  country         String?
  message         String?
  tripPreferences Json?
  status          String   @default("new") // "new" | "contacted" | "won" | "lost"
  assignedToId    String?
  assignedTo      User?    @relation(fields: [assignedToId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("leads")
}

model Destination {
  id            String      @id @default(uuid())
  name          String
  region        String      // "Bromo", "Ijen", "Tumpak Sewu", "Malang/Batu", etc.
  lat           Float
  lng           Float
  category      String      // "mountain", "waterfall", "crater", "city", "beach"
  description   String?
  ticketPrice   Decimal     @default(0) @db.Decimal(12, 2)
  imageUrl      String?
  rating        Float?      @default(4.9)
  reviewCount   Int?        @default(120)
  googleMapsUrl String?
  isActive      Boolean     @default(true)
  
  activities    Activity[]
  tripItems     TripItem[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("destinations")
}

model VehicleType {
  id            String   @id @default(uuid())
  name          String   // "Avanza / Innova", "Hiace", "Alphard / Lexus", "Bus medium"
  capacityMin   Int      @default(1)
  capacityMax   Int      @default(5)
  ratePerKm     Decimal  @default(5000) @db.Decimal(12, 2)
  description   String?
  imageUrl      String?
  rating        Float?   @default(4.9)
  reviewCount   Int?     @default(85)
  googleMapsUrl String?
  isActive      Boolean  @default(true)
  
  trips         Trip[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("vehicle_types")
}

model Hotel {
  id                   String   @id @default(uuid())
  name                 String
  region               String   // "Bromo", "Banyuwangi", "Malang", etc.
  hotelClass           String   // "budget" | "standard" | "premium"
  pricePerRoomPerNight Decimal  @db.Decimal(12, 2)
  paxPerRoom           Int      @default(2)
  description          String?
  imageUrl             String?
  rating               Float?   @default(4.8)
  reviewCount          Int?     @default(95)
  googleMapsUrl        String?
  lat                  Float?   // GPS Latitude for accurate itinerary & mileage routing
  lng                  Float?   // GPS Longitude for accurate itinerary & mileage routing
  isActive             Boolean  @default(true)
  
  trips                Trip[]
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("hotels")
}

model Activity {
  id            String       @id @default(uuid())
  name          String
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  ticketPrice   Decimal      @default(0) @db.Decimal(12, 2)
  description   String?
  isActive      Boolean      @default(true)
  
  tripItems     TripItem[]
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("activities")
}

model MealOption {
  id          String   @id @default(uuid())
  name        String
  pricePerPax Decimal  @default(0) @db.Decimal(12, 2)
  description String?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("meal_options")
}

model PriceConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("price_configs")
}

model Trip {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  title          String
  tripType       String      @default("private") // "solo" | "duo" | "private" | "group"
  startDate      DateTime
  endDate        DateTime
  numPax         Int         @default(2)
  
  vehicleTypeId  String
  vehicleType    VehicleType @relation(fields: [vehicleTypeId], references: [id])
  
  hotelId        String?
  hotel          Hotel?      @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  
  pickupPoint    String
  pickupLat      Float?
  pickupLng      Float?
  dropoffPoint   String
  dropoffLat     Float?
  dropoffLng     Float?
  
  status         String      @default("draft") // "draft" | "booked" | "confirmed" | "in_progress" | "completed" | "cancelled"
  totalDistanceKm Float      @default(0)
  transportCost  Decimal     @default(0) @db.Decimal(12, 2)
  hotelCost      Decimal     @default(0) @db.Decimal(12, 2)
  ticketsCost    Decimal     @default(0) @db.Decimal(12, 2)
  mealsCost      Decimal     @default(0) @db.Decimal(12, 2)
  guideCost      Decimal     @default(0) @db.Decimal(12, 2)
  withGuide      Boolean     @default(true)
  marginAmount   Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal     @default(0) @db.Decimal(12, 2)
  pricePerPax    Decimal     @default(0) @db.Decimal(12, 2)
  currency       String      @default("IDR")
  
  days           TripDay[]
  booking        Booking?
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("trips")
}

model TripDay {
  id        String     @id @default(uuid())
  tripId    String
  trip      Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber Int
  date      DateTime?
  title     String?
  note      String?
  
  items     TripItem[]
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("trip_days")
}

model TripItem {
  id            String       @id @default(uuid())
  tripDayId     String
  tripDay       TripDay      @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  orderIndex    Int          @default(0)
  type          String       // "destination" | "activity" | "meal" | "pickup" | "dropoff"
  
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  
  activityId    String?
  activity      Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  
  startTime     String?
  endTime       String?
  note          String?
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("trip_items")
}

model Booking {
  id               String    @id @default(uuid())
  tripId           String    @unique
  trip             Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation("CustomerBookings", fields: [userId], references: [id])
  
  assignedGuideId  String?
  assignedGuide    User?     @relation("AssignedTrips", fields: [assignedGuideId], references: [id])
  
  totalAmount      Decimal   @db.Decimal(12, 2)
  currency         String    @default("IDR")
  status           String    @default("pending") // "pending" | "paid" | "confirmed" | "in_progress" | "completed" | "cancelled" | "refunded"
  
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  
  midtransOrderId  String?   @unique
  paymentType      String?
  paidAt           DateTime?
  
  payments         Payment[]
  expenses         Expense[]
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("bookings")
}

model Payment {
  id                   String    @id @default(uuid())
  bookingId            String
  booking              Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount               Decimal   @db.Decimal(12, 2)
  currency             String    @default("IDR")
  status               String    // "pending" | "settlement" | "capture" | "deny" | "cancel" | "expire" | "refund"
  midtransTransactionId String?
  paymentType          String?
  paidAt               DateTime?
  rawPayload           Json?
  
  createdAt            DateTime  @default(now())

  @@map("payments")
}

model Expense {
  id           String   @id @default(uuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  submittedById String
  submittedBy  User     @relation("SubmittedExpenses", fields: [submittedById], references: [id])
  
  category     String   // "fuel" | "toll" | "ticket" | "accommodation" | "meal" | "other"
  amount       Decimal  @db.Decimal(12, 2)
  note         String?
  receiptUrl   String?
  status       String   @default("submitted") // "submitted" | "approved" | "rejected"
  
  approvedById String?
  approvedBy   User?    @relation("ApprovedExpenses", fields: [approvedById], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("expenses")
}

